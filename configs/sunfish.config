# Board facts of the Pixel 4a (sunfish) that are true of this phone and of no other SM7150.
# Read from frokfrdk's sunfish sources (touch, display); the kernel still carries its own copies.
CONFIG_DEVICE="sunfish"
CONFIG_PANEL_WIDTH=1080
CONFIG_PANEL_HEIGHT=2340
# STMicro FTM5 at I2C address 0x49 on GENI SE7 (qup11; TLMM 6/7 are SDA/SCL), reset TLMM 8, IRQ TLMM 9
CONFIG_TOUCH_CHIP="stm-ftm5"
CONFIG_TOUCH_I2C_ADDR=0x49
CONFIG_TOUCH_SE_PA=0x00a84000
CONFIG_TOUCH_RESET_GPIO=8
CONFIG_TOUCH_IRQ_GPIO=9
# TLMM 72 hands the touch bus to the AP when driven low (it belongs to the sensor hub otherwise)
CONFIG_TOUCH_BUS_SWITCH_GPIO=72
# its supply is PM6150 GPIO4 (SPMI SID 0, PPID 0x0c3)
CONFIG_TOUCH_POWER="pm6150-gpio4"
CONFIG_TOUCH_MAX_X=1079
CONFIG_TOUCH_MAX_Y=2339
# the framebuffer Google's bootloader leaves, and the MDP that scans it out
CONFIG_SPLASH_PA=0x9c000000
CONFIG_MDP_PA=0x0ae00000
